---
import CoffeeCard from './CoffeeCard.astro';
import { coffees } from '../data/coffees';
---

<section id="coffee" class="mx-auto max-w-6xl scroll-mt-6 px-4 py-16 md:px-8 md:py-24">
  <h2 class="font-display text-3xl font-bold md:text-4xl">Що смажимо зараз</h2>
  <p class="mt-3 max-w-xl text-muted">Сонце на пачці показує ступінь обсмаження: що вище воно піднялось, то темніша кава.</p>

  <div class="mt-10 grid gap-6 md:grid-cols-3">
    {coffees.map((coffee) => <CoffeeCard coffee={coffee} />)}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-coffee]').forEach((card) => {
    const priceValue = card.querySelector('[data-price-value]');
    const radios = card.querySelectorAll<HTMLInputElement>('input[type="radio"]');

    radios.forEach((radio) => {
      radio.addEventListener('change', () => {
        if (priceValue) priceValue.textContent = radio.dataset.price ?? '';
      });
    });

    card.querySelector('[data-order-button]')?.addEventListener('click', () => {
      const coffeeSelect = document.querySelector<HTMLSelectElement>('#order-coffee');
      const weightSelect = document.querySelector<HTMLSelectElement>('#order-weight');
      const checked = card.querySelector<HTMLInputElement>('input[type="radio"]:checked');

      if (coffeeSelect) coffeeSelect.value = card.dataset.coffee ?? '';
      if (weightSelect && checked) weightSelect.value = checked.value;
    });
  });
</script>
