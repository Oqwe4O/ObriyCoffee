---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Benefits from '../components/Benefits.astro';
import Coffees from '../components/Coffees.astro';
import Process from '../components/Process.astro';
import OrderForm from '../components/OrderForm.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Обрій — свіжообсмажена кава зі Львова"
  description="Маленька обсмажка зі Львова. Три сорти спешелті-кави, свіжі партії щотижня і доставка Новою Поштою."
>
  <div id="top">
    <Header />
    <main>
      <Hero />
      <Benefits />
      <Coffees />
      <Process />
      <OrderForm />
      <Faq />
    </main>
    <Footer />
  </div>
</Layout>
